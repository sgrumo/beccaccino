# Copy to infra/on-prem/.env.deploy on the deploy host and fill in.
# This file stays on the server — it is never copied by CI and never committed.

# Postgres (the `db` service)
POSTGRES_USER=averziano
POSTGRES_PASSWORD=change-me
POSTGRES_DB=averziano_prod

# App
# Host name the app is served on (used to build URLs).
PHX_HOST=example.com
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=change-me
# Must match the Postgres credentials above; `db` is the compose service name.
DATABASE_URL=ecto://averziano:change-me@db/averziano_prod
POOL_SIZE=10

# Port the app listens on inside the container.
PORT=4000
# Host side of the published port; keep the bind on loopback when a reverse
# proxy fronts the app, set APP_BIND=0.0.0.0 to expose it directly.
APP_BIND=127.0.0.1
APP_PORT=4000
